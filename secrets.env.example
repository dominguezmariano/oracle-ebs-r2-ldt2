# Copiar a secrets.env (gitignored y excluido de la imagen Docker) y completar.
# Una variable por ambiente: EBS_DB_PASSWORD_<NOMBRE_AMBIENTE_EN_MAYUSCULAS>
# (todo lo que no sea letra/numero pasa a "_", ej: "TEST-FIX" -> TEST_FIX).
# El usuario DB se define en Configuracion > Ambientes.
EBS_DB_PASSWORD_DESA=
EBS_DB_PASSWORD_TEST=
EBS_DB_PASSWORD_UAT=

# Alternativa: apuntar a un archivo (Docker/Nebula secrets) en vez del valor
# EBS_DB_PASSWORD_DESA_FILE=/run/secrets/ebs_db_password_desa
