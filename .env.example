FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Oracle EBS connection (per ambiente, configurado en la app)
# Estos son los defaults iniciales
ORACLE_DEFAULT_HOST=localhost
ORACLE_DEFAULT_PORT=1521
ORACLE_DEFAULT_SERVICE=EBSR12

# SQLite path para configuracion local
DATABASE_URL=sqlite:///r2ldt2.db

# ---- Autenticacion SSO Despegar (ATP3 / OIDC) ----
# false = sin login, todo corre como AUTH_DEV_USER (desarrollo / pruebas)
AUTH_ENABLED=false
AUTH_DEV_USER=dev-local@despegar.com
# Emails admin separados por coma. Vacio = sin restriccion de rol en /configuracion
AUTH_ADMINS=
# Solo requeridos con AUTH_ENABLED=true
ATP3_CLIENT_ID=
ATP3_CLIENT_SECRET=
ATP3_AUTH_URL=https://auth.despegar.com
ATP3_TOKEN_URL=https://auth-core.us-east-1.despegar.net/token
# Bundle de CAs para verificar TLS de auth-core (opcional)
ATP3_CA_BUNDLE=
OIDC_ALLOWED_EMAIL_DOMAIN=despegar.com
AUTH_SESSION_HOURS=6
SESSION_COOKIE_SECURE=false
